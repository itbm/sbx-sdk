{
  "name": "itbm/sbx-sdk",
  "version": "0.34.0",
  "description": "PHP client for the sbx daemon HTTP API",
  "keywords": [
    "itbm",
    "api",
    "sdk"
  ],
  "license": "Apache-2.0",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-curl": "*",
    "psr/http-client": "^1.0",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "php-http/discovery": "^1.0",
    "php-http/multipart-stream-builder": "^1.0",
    "guzzlehttp/guzzle": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5.22",
    "friendsofphp/php-cs-fixer": "3.5.0",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "Sbx\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sbx\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "build": [
      "@php -l src/SbxClientFactory.php"
    ],
    "test": "phpunit tests/SbxClientFactoryTest.php",
    "analyze": "phpstan analyze src tests --memory-limit=1G"
  },
  "homepage": "https://github.com/itbm/sbx-sdk"
}
